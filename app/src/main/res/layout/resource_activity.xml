<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:src="@drawable/back"
            android:layout_margin="10dp"
            />

        <TextView
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resources"
            android:textSize="30sp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginEnd="50dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textStyle="bold"
            />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Looking for support?"
        android:textAlignment="center"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Here are some useful links to help you find support"
        android:textAlignment="center"
        android:textSize="16sp"
        android:paddingStart="35dp"
        android:paddingEnd="35dp"
        />

    <Button
        android:id="@+id/counseling_service_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Counseling Service"
        android:backgroundTint="@color/black"
        android:layout_margin="20dp"
        />

    <Button
        android:id="@+id/support_group_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Support Group"
        android:backgroundTint="@color/black"
        android:layout_margin="20dp"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contact"
        android:textAlignment="center"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Charles :+1 54638927364"
        android:textAlignment="center"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Raj :+1 34708374023"
        android:textAlignment="center"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        />


</LinearLayout>